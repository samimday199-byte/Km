<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <!-- Canvas-rendered Background (Solid / 2-Stop / 4-Stop / Liquid Glass) -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_description"
        android:scaleType="fitXY" />

    <!-- Foreground Real TextViews & Live Chronometer -->
    <LinearLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical|start"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- Line 1: Block Title (6 Bundled Fonts switched via visibility) -->
        <TextView
            android:id="@+id/widget_title_space_grotesk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/space_grotesk"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_title"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="visible" />

        <TextView
            android:id="@+id/widget_title_outfit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_title"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_title_jetbrains_mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/jetbrains_mono"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_title"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_title_playfair_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/playfair_display"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_title"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_title_syne"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/syne"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_title"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_title_plus_jakarta_sans"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_title"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Line 2: Time Range -->
        <TextView
            android:id="@+id/widget_time_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_time"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />

        <!-- Line 3: Total Duration + Live Chronometer Countdown -->
        <LinearLayout
            android:id="@+id/widget_duration_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_duration_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/jetbrains_mono"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_duration"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <Chronometer
                android:id="@+id/widget_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:countDown="true"
                android:fontFamily="@font/jetbrains_mono"
                android:includeFontPadding="false"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Optional Thin Progress Bar -->
        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:indeterminate="false"
            android:max="1000"
            android:progress="420"
            android:progressDrawable="@drawable/widget_progress_bar" />
    </LinearLayout>
</FrameLayout>
